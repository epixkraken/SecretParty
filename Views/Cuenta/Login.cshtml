@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    ViewData["Fondo"] = "fondo-blanco";
}

<a asp-controller="Home" asp-action="Index">
    <img src="~/img/logo-texto.png" alt="Secret Party" class="logo-arriba" />
</a>

<form asp-action="Login" method="post" class="tarjeta-patron">
    <div asp-validation-summary="ModelOnly" class="error"></div>
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="campo">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="input" placeholder="chloe.moss@gmail.com" />
        <span asp-validation-for="Email" class="error"></span>
    </div>

    <div class="campo">
        <label asp-for="Password"></label>
        <input asp-for="Password" class="input" placeholder="••••••••" />
        <span asp-validation-for="Password" class="error"></span>
    </div>

    <div class="acciones">
        <button type="submit" class="boton boton-amarillo">Iniciar Sesión</button>
    </div>
</form>

<p class="pie">
    ¿Todavía no eres miembro?
    <a asp-action="Registro" class="destacado">Sign Up</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
