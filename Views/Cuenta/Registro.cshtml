@model RegistroViewModel
@{
    ViewData["Title"] = "Crear Cuenta";
    ViewData["Fondo"] = "fondo-blanco";
}

<a asp-controller="Home" asp-action="Index">
    <img src="~/img/logo-texto.png" alt="Secret Party" class="logo-arriba" />
</a>

<form asp-action="Registro" method="post" class="tarjeta-patron">
    <div asp-validation-summary="ModelOnly" class="error"></div>

    <div class="campo">
        <label asp-for="NombreUsuario"></label>
        <input asp-for="NombreUsuario" class="input" placeholder="chloemoss" />
        <span asp-validation-for="NombreUsuario" class="error"></span>
    </div>

    <div class="campo">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="input" placeholder="chloe.moss@gmail.com" />
        <span asp-validation-for="Email" class="error"></span>
    </div>

    <div class="campo">
        <label asp-for="Password"></label>
        <input asp-for="Password" class="input" placeholder="mínimo 6 caracteres" />
        <span asp-validation-for="Password" class="error"></span>
    </div>

    <div class="campo">
        <label asp-for="ConfirmarPassword"></label>
        <input asp-for="ConfirmarPassword" class="input" placeholder="repite tu contraseña" />
        <span asp-validation-for="ConfirmarPassword" class="error"></span>
    </div>

    <div class="acciones">
        <button type="submit" class="boton boton-amarillo">Crear Cuenta</button>
    </div>
</form>

<p class="pie">
    algo increíble está pasando a la vuelta de la <span class="destacado">esquina</span>
</p>

<p class="centrado">
    ¿Ya tienes cuenta? <a asp-action="Login" class="link-texto">Inicia sesión</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
