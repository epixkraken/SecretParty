@model EditarPerfilViewModel
@{
    ViewData["Title"] = "Configura tu cuenta";
}

<h1>configura tu <em>cuenta</em></h1>

<form asp-action="Editar" method="post" class="perfil-form">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="NombreUsuario"></label>
        <input asp-for="NombreUsuario" class="form-control" />
        <span asp-validation-for="NombreUsuario" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Descripcion"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="3"
                  placeholder="Cuéntanos de ti..."></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FechaNacimiento"></label>
        <input asp-for="FechaNacimiento" class="form-control" />
        <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Intereses"></label>
        <input asp-for="Intereses" class="form-control" placeholder="música, karaoke, playa..." />
    </div>

    <div class="mb-3">
        <label asp-for="Instagram"></label>
        <input asp-for="Instagram" class="form-control" placeholder="@@tuusuario" />
    </div>

    <button type="submit" class="btn btn-primary">perfil listo</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
