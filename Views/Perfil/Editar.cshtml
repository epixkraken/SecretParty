@model EditarPerfilViewModel
@{
    ViewData["Title"] = "Configura tu cuenta";
    ViewData["Fondo"] = "fondo-liso";
}

<img src="~/img/logo-texto.png" alt="Secret Party" class="logo-arriba" />

<h1 class="titulo">configura tu <em>nueva cuenta</em></h1>

@* enctype="multipart/form-data" es OBLIGATORIO para mandar archivos.
   Sin eso, el navegador solo manda el nombre del archivo y no la foto. *@
<form asp-action="Editar" method="post" enctype="multipart/form-data" class="tarjeta-verde">
    <div asp-validation-summary="ModelOnly" class="error"></div>

    <div class="campo">
        <label asp-for="NombreUsuario"></label>
        <input asp-for="NombreUsuario" class="input" />
        <span asp-validation-for="NombreUsuario" class="error"></span>
    </div>

    <div class="campo">
        <label asp-for="Descripcion"></label>
        <textarea asp-for="Descripcion" class="input" placeholder="Planning events since 2025"></textarea>
        <span asp-validation-for="Descripcion" class="error"></span>
    </div>

    <div class="campo">
        <label asp-for="FechaNacimiento"></label>
        <input asp-for="FechaNacimiento" class="input" />
        <span asp-validation-for="FechaNacimiento" class="error"></span>
    </div>

    @* HOBBIES: checkboxes escondidos + su texto con forma de pastilla.
       Todos se llaman name="Intereses": el servidor recibe la lista de los marcados. *@
    @{
        var anteriores = (ViewBag.HobbiesAnteriores as List<string>) ?? new List<string>();
        var extras = anteriores.Where(a => !Hobbies.Todos.Contains(a)).ToList();
    }
    <fieldset class="selector-pastillas">
        <legend>Hobbies <span class="nota">(elige hasta @Hobbies.Maximo)</span></legend>
        <span asp-validation-for="Intereses" class="error"></span>

        @foreach (var grupo in Hobbies.Catalogo)
        {
            <p class="hobbies-grupo">@grupo.Key</p>
            <div class="hobbies">
                @foreach (var h in grupo.Value)
                {
                    <label class="hobby-check">
                        <input type="checkbox" name="Intereses" value="@h" checked="@Model.Intereses.Contains(h)" />
                        <span>@h</span>
                    </label>
                }
            </div>
        }

        @if (extras.Count > 0)
        {
            <p class="hobbies-grupo">Los que ya tenías</p>
            <div class="hobbies">
                @foreach (var h in extras)
                {
                    <label class="hobby-check">
                        <input type="checkbox" name="Intereses" value="@h" checked="@Model.Intereses.Contains(h)" />
                        <span>@h</span>
                    </label>
                }
            </div>
        }
    </fieldset>

    <div class="campo">
        <label asp-for="Instagram"></label>
        <input asp-for="Instagram" class="input" placeholder="@@tuusuario" />
    </div>

    <div class="campo subir-foto">
        <!-- Vista previa: la foto actual, o la nueva apenas la eliges (lo hace site.js) -->
        <div class="avatar avatar-chico" id="vista-previa">
            @if (!string.IsNullOrEmpty(Model.FotoActual))
            {
                <img src="@Model.FotoActual" alt="Tu foto" class="avatar-foto" />
            }
            else
            {
                @(string.IsNullOrEmpty(Model.NombreUsuario) ? "?" : Model.NombreUsuario[0])
            }
        </div>

        <div>
            <!-- El input de archivo real va escondido; el label hace de "botón" -->
            <label for="Foto" class="link-galeria">subir foto de perfil: <em>seleccionar de galería</em></label>
            <input asp-for="Foto" type="file" accept="image/png, image/jpeg, image/webp, image/gif"
                   class="input-archivo" data-vista-previa="vista-previa" />
            <span asp-validation-for="Foto" class="error"></span>

            @if (!string.IsNullOrEmpty(Model.FotoActual))
            {
                <label class="check-quitar"><input asp-for="QuitarFoto" /> quitar mi foto</label>
            }
        </div>
    </div>

    <div class="acciones">
        <button type="submit" class="boton boton-lila">perfil listo</button>
        <a asp-action="Index" class="link-texto">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
