@model EditarPerfilViewModel
@{
    ViewData["Title"] = "Configura tu cuenta";
    ViewData["Fondo"] = "fondo-liso";
}

<img src="~/img/logo-texto.png" alt="Secret Party" class="logo-arriba" />

<h1 class="titulo">configura tu <em>nueva cuenta</em></h1>

<form asp-action="Editar" method="post" class="tarjeta-verde">
    <div asp-validation-summary="ModelOnly" class="error"></div>

    <div class="campo">
        <label asp-for="NombreUsuario"></label>
        <input asp-for="NombreUsuario" class="input" />
        <span asp-validation-for="NombreUsuario" class="error"></span>
    </div>

    <div class="campo">
        <label asp-for="Descripcion"></label>
        <textarea asp-for="Descripcion" class="input" placeholder="Planning events since 2025"></textarea>
        <span asp-validation-for="Descripcion" class="error"></span>
    </div>

    <div class="campo">
        <label asp-for="FechaNacimiento"></label>
        <input asp-for="FechaNacimiento" class="input" />
        <span asp-validation-for="FechaNacimiento" class="error"></span>
    </div>

    <div class="campo">
        <label asp-for="Intereses"></label>
        <input asp-for="Intereses" class="input" placeholder="música, karaoke, playa..." />
    </div>

    <div class="campo">
        <label asp-for="Instagram"></label>
        <input asp-for="Instagram" class="input" placeholder="@@tuusuario" />
    </div>

    <p class="nota">subir foto de perfil: próximamente</p>

    <div class="acciones">
        <button type="submit" class="boton boton-lila">perfil listo</button>
        <a asp-action="Index" class="link-texto">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
