@model SecretParty.Models.Usuario
@{
    ViewData["Title"] = "Eliminar cuenta";
}

<h1 class="titulo">¿Segura que quieres <em>irte?</em></h1>

<section class="tarjeta">
    <p>Vas a eliminar la cuenta <strong>@Model.NombreUsuario</strong> (@Model.Email).</p>
    <p>Esto <strong>no se puede deshacer</strong>.</p>

    <div class="acciones">
        <form asp-action="Eliminar" method="post" class="form-en-linea">
            <button type="submit" class="boton boton-borde boton-chico link-peligro">Sí, eliminar mi cuenta</button>
        </form>
        <a asp-action="Index" class="boton boton-lila boton-chico">No, regresar</a>
    </div>
</section>
