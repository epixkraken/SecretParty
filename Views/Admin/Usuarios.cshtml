@model List<UsuarioAdminFila>

@{
    ViewData["Title"] = "Usuarios";
    ViewData["Ancho"] = "pantalla-ancha";
}

<h1 class="titulo">Todos los <em>usuarios</em></h1>

<partial name="_MenuAdmin" />

<section class="tarjeta">
    <p>Usuarios registrados: <strong>@Model.Count</strong></p>

    <ul class="lista-admin">
        @foreach (var f in Model)
        {
            var u = f.Usuario;
            var enRiesgo = f.Reportes >= AdminController.LimiteReportes;
            int? edad = u.FechaNacimiento == null ? null : Edad.Calcular(u.FechaNacimiento.Value);
            var esMenor = edad < Edad.Minima;

            <li class="@(enRiesgo || esMenor ? "fila-riesgo" : "")">
                <div class="avatar avatar-chico">@u.NombreUsuario[0]</div>
                <div class="fila-datos">
                    <strong>@u.NombreUsuario</strong>
                    @if (u.EsAdmin)
                    {
                        <span class="etiqueta">Admin</span>
                    }
                    @if (f.Reportes > 0)
                    {
                        <span class="etiqueta @(enRiesgo ? "etiqueta-roja" : "etiqueta-amarilla")">
                            @f.Reportes @(f.Reportes == 1 ? "flag" : "flags")
                        </span>
                    }
                    @* Datos que entraron antes de la validación de edad *@
                    @if (esMenor)
                    {
                        <span class="etiqueta etiqueta-roja">menor de edad</span>
                    }
                    else if (edad == null && !u.EsAdmin)
                    {
                        <span class="etiqueta etiqueta-amarilla">sin fecha</span>
                    }
                    <div class="nota">
                        @u.Email · @(edad == null ? "" : $"{edad} años · ")desde @u.FechaRegistro.ToString("dd/MM/yyyy")
                    </div>
                </div>

                @if (!u.EsAdmin)
                {
                    <div class="fila-acciones">
                        <a asp-action="EditarUsuario" asp-route-id="@u.Id" title="Editar" class="boton-icono"><partial name="_Icono" model='"lapiz"' /></a>
                        <a asp-action="NuevoReporte" asp-route-usuarioId="@u.Id" title="Flaguear" class="boton-icono"><partial name="_Icono" model='"bandera"' /></a>
                        <a asp-action="EliminarUsuario" asp-route-id="@u.Id" title="Eliminar" class="boton-icono link-peligro"><partial name="_Icono" model='"basura"' /></a>
                    </div>
                }
            </li>
        }
    </ul>
</section>
