@{
    ViewData["Title"] = "Bienvenida";
    // Admin -> su panel; usuario con sesión -> su perfil; sin sesión -> al login
    var destino = User.IsInRole("Admin") ? Url.Action("Index", "Admin")
        : User.Identity?.IsAuthenticated == true ? Url.Action("Index", "Perfil")
        : Url.Action("Login", "Cuenta");
}

<section class="inicio">
    <img src="~/img/logo-copa.png" alt="Logo de Secret Party: copa de martini con candado" class="inicio-logo" />

    <a href="@destino" class="boton boton-lila boton-inicio">FIND THE PARTY</a>

    <p class="firma">by: bff4.com</p>
</section>
